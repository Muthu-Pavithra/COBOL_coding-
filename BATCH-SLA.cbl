IDENTIFICATION DIVISION.
PROGRAM-ID. BATCH-SLA.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-START-TIME       PIC X(6).
01 WS-END-TIME         PIC X(6).
01 WS-MAX-DURATION     PIC 9(6).

01 WS-START-HOUR       PIC 99.
01 WS-START-MIN        PIC 99.
01 WS-START-SEC        PIC 99.

01 WS-END-HOUR         PIC 99.
01 WS-END-MIN          PIC 99.
01 WS-END-SEC          PIC 99.

01 WS-START-SECONDS    PIC 9(8) COMP.
01 WS-END-SECONDS      PIC 9(8) COMP.
01 WS-ELAPSED          PIC 9(8) COMP.

01 WS-VALID            PIC X VALUE "Y".

PROCEDURE DIVISION.

    DISPLAY "ENTER START TIME (HHMMSS): "
    ACCEPT WS-START-TIME

    DISPLAY "ENTER END TIME (HHMMSS): "
    ACCEPT WS-END-TIME

    DISPLAY "ENTER MAXIMUM DURATION (SECONDS): "
    ACCEPT WS-MAX-DURATION

    IF WS-START-TIME IS NUMERIC
       AND WS-END-TIME IS NUMERIC

        MOVE WS-START-TIME(1:2)
          TO WS-START-HOUR
        MOVE WS-START-TIME(3:2)
          TO WS-START-MIN
        MOVE WS-START-TIME(5:2)
          TO WS-START-SEC

        MOVE WS-END-TIME(1:2)
          TO WS-END-HOUR
        MOVE WS-END-TIME(3:2)
          TO WS-END-MIN
        MOVE WS-END-TIME(5:2)
          TO WS-END-SEC

        IF WS-START-HOUR > 23
           OR WS-START-MIN > 59
           OR WS-START-SEC > 59
           OR WS-END-HOUR > 23
           OR WS-END-MIN > 59
           OR WS-END-SEC > 59

            MOVE "N" TO WS-VALID
        END-IF

    ELSE
        MOVE "N" TO WS-VALID
    END-IF

    IF WS-VALID = "N"
        DISPLAY "STATUS: INVALID TIME"
        STOP RUN
    END-IF

    COMPUTE WS-START-SECONDS =
        WS-START-HOUR * 3600
      + WS-START-MIN * 60
      + WS-START-SEC

    COMPUTE WS-END-SECONDS =
        WS-END-HOUR * 3600
      + WS-END-MIN * 60
      + WS-END-SEC

    IF WS-END-SECONDS < WS-START-SECONDS
        COMPUTE WS-ELAPSED =
            WS-END-SECONDS + 86400
          - WS-START-SECONDS
    ELSE
        COMPUTE WS-ELAPSED =
            WS-END-SECONDS - WS-START-SECONDS
    END-IF

    DISPLAY "ELAPSED SECONDS: " WS-ELAPSED

    IF WS-ELAPSED <= WS-MAX-DURATION
        DISPLAY "STATUS: WITHIN SLA"
    ELSE
        DISPLAY "STATUS: SLA EXCEEDED"
    END-IF

    STOP RUN.
